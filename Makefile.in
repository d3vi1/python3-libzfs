PYTHON ?= python3
PREFIX ?= /usr/local

PXIS = \
	converter.pxi \
	nvpair.pxi \
	pxd/config.pxi \
	pxd/sendflags.pxi

PXDS = \
	pxd/libzfs.pxd \
	pxd/nvpair.pxd \
	pxd/types.pxd \
	pxd/zfs.pxd

build: libzfs.pyx ${PXIS} ${PXDS}
	${PYTHON} -m pip install . --no-deps --no-build-isolation --target build/lib

clean:
	rm -rf build dist libzfs.c *.egg-info

install:
	${PYTHON} -m pip install . --no-deps --no-build-isolation --prefix ${PREFIX}
